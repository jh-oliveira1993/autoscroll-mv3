{
  "manifest_version": 3,
  "name": "AutoScroll",
  "version": "5.0.0",
  "description": "Rolagem automática estilo Firefox (clique do meio) para o Chrome no Linux e macOS.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "images/icons/icon16.png",
    "32": "images/icons/icon32.png",
    "48": "images/icons/icon48.png",
    "128": "images/icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/defaults.js", "content/autoscroll.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/origin/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
